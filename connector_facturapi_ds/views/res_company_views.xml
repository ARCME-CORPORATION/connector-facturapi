<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ds" model="ir.ui.view">
        <field name="name">res.company.form.facturapi.ds</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Documento Soporte" name="facturapi_ds"
                      invisible="not connector_ds_enabled">
                    <group string="Configuración DS">
                        <group>
                            <field name="connector_ds_enabled"/>
                        </group>
                        <group>
                            <field name="connector_dian_environment" string="Ambiente DIAN"/>
                        </group>
                    </group>
                    <group string="Rangos de Numeración DS">
                        <div class="mb8">
                            <button name="action_GetNumberingRangeDS"
                                    string="Consultar Rangos DS"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-refresh"/>
                        </div>
                        <field name="connector_ds_numbering_ranges" readonly="1"
                               placeholder="Presione 'Consultar Rangos DS' para obtener la información de DIAN"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
