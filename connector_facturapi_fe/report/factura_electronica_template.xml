<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_factura_electronica_dian_qweb">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
          <t t-call="web.external_layout">
            <div class="page">
              <div class="row">
                <div class="col">
                  <h2>Factura Electrónica de Venta</h2>
                  <p><strong>Número:</strong> <t t-esc="o.l10n_latam_document_number or o.name"/></p>
                  <p><strong>CUFE:</strong> <t t-esc="o.connector_cufe or ''"/></p>
                  <p><strong>Fecha:</strong> <t t-esc="o.invoice_date"/></p>
                  <p><strong>Cliente:</strong> <t t-esc="o.partner_id.name"/></p>
                  <p><strong>NIT:</strong> <t t-esc="o.partner_id.vat"/></p>
                  <hr/>
                  <table class="table table-sm">
                    <thead>
                      <tr>
                        <th>Item</th>
                        <th>Cantidad</th>
                        <th>Precio Unit.</th>
                        <th>Total</th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-foreach="o.invoice_line_ids" t-as="line">
                        <tr>
                          <td><t t-esc="line.name"/></td>
                          <td><t t-esc="line.quantity"/></td>
                          <td><t t-esc="'%0.2f' % line.price_unit"/></td>
                          <td><t t-esc="'%0.2f' % line.price_subtotal"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                  <div class="row">
                    <div class="col text-right">
                      <p><strong>Subtotal:</strong> <t t-esc="'%0.2f' % o.amount_untaxed"/></p>
                      <p><strong>IVA:</strong> <t t-esc="'%0.2f' % (o.amount_total - o.amount_untaxed)"/></p>
                      <p><strong>Total:</strong> <t t-esc="'%0.2f' % o.amount_total"/></p>
                    </div>
                  </div>
                  <div class="row" t-if="o.connector_qr_code">
                    <div class="col">
                      <img t-att-src="'data:image/png;base64,%s' % o.connector_qr_code" width="100"/>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </t>
      </t>
    </template>
</odoo>
