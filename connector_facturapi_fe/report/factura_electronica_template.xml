<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit standard invoice report to add DIAN electronic invoice fields -->
    <template id="report_factura_electronica_dian_inherit_document"
              inherit_id="account.report_invoice_document">

        <!-- Replace document title with DIAN FE title when applicable -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <t t-if="is_factura_electronica_report or o.connector_facturapi_document_id or o.connector_cufe">
                    <span>FACTURA ELECTRÓNICA DE VENTA</span>
                    <t t-if="o.name and o.name != '/'">
                        <br/>
                        <span t-field="o.name"/>
                    </t>
                </t>
                <t t-else="">
                    <span t-if="not proforma"></span>
                    <span t-else="">PROFORMA</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
                    <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
                    <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
                    <span t-if="o.name and o.name != '/'" t-field="o.name">INV/2023/0001</span>
                </t>
            </t>
        </xpath>

        <!-- After info section, add CUFE, technical key, and resolution -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <div class="row mb-3" id="dian_header_info"
                 t-if="o.connector_facturapi_document_id or o.connector_cufe">
                <div class="col-12">
                    <table class="table table-sm table-borderless mb-0" style="font-size: 8pt;">
                        <t t-if="o.connector_cufe">
                            <tr>
                                <td class="text-start" style="width: 120px;"><strong>CUFE</strong></td>
                                <td class="text-start" style="word-break: break-all; font-size: 7pt;">
                                    <span t-field="o.connector_cufe"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="o.connector_sequence_range_id">
                            <tr>
                                <td class="text-start"><strong>Resolución DIAN</strong></td>
                                <td class="text-start">
                                    <span t-field="o.connector_sequence_range_id.name"/>
                                    <t t-if="o.connector_sequence_range_id.date_from">
                                        <br/>
                                        Vigencia: <span t-field="o.connector_sequence_range_id.date_from"/>
                                        al <span t-field="o.connector_sequence_range_id.date_to"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <t t-if="o.connector_facturapi_document_id">
                            <tr>
                                <td class="text-start"><strong>Fecha Emisión DIAN</strong></td>
                                <td class="text-start">
                                    <span t-field="o.connector_facturapi_document_id.create_date"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
            </div>
        </xpath>

        <!-- After right-elements (totals), add QR code and legal text -->
        <xpath expr="//div[@id='right-elements']" position="after">
            <div class="row mb-3" t-if="o.connector_qr_code" id="dian_qr_block">
                <div class="col-12 text-center">
                    <img t-att-src="'data:image/png;base64,%s' % o.connector_qr_code" width="120"/>
                    <p style="font-size: 7pt;">Código QR DIAN</p>
                </div>
            </div>
            <div class="row mb-3" id="dian_legal_text" style="font-size: 7pt; text-align: justify;">
                <div class="col-12">
                    <p>Este documento es la representación gráfica de un documento electrónico.
                    El contenido de este documento no constituye título ejecutivo, de acuerdo con
                    el artículo 774 del Código de Comercio.</p>
                    <p t-if="o.connector_cufe">
                        CUFE: <span t-field="o.connector_cufe"/>
                    </p>
                </div>
            </div>
        </xpath>

    </template>

    <!-- Wrapper template for the FE report action -->
    <template id="report_factura_electronica_dian_qweb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-set="is_factura_electronica_report" t-value="True"/>
                <t t-call="account.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
