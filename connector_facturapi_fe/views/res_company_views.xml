<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_fe" model="ir.ui.view">
        <field name="name">res.company.form.facturapi.fe</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturación Electrónica" name="facturapi_fe">
                    <group string="Configuración FE">
                        <group>
                            <field name="connector_fe_enabled" />
                            <field name="connector_fe_auto_send"
                                invisible="not connector_fe_enabled" />
                            <field name="certificate_id"
                                domain="[('scope', '=', 'facturapi'), ('is_valid', '=', True)]"
                                context="{'default_scope': 'facturapi'}" />
                            <div class="mb8">
                                <button name="action_UploadCertificate"
                                    string="Enviar Certificado a API"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-upload"
                                    invisible="not certificate_id" />
                            </div>
                        </group>
                        <group>
                            <field name="facturapi_api_url" string="API URL" />
                            <field name="facturapi_company_id" string="Company UUID" />
                            <field name="facturapi_api_key" password="True" string="API Key" />
                            <field name="connector_dian_environment" string="Ambiente DIAN" />
                            <field name="connector_software_id" string="Software ID" />
                            <field name="connector_software_pin" password="True"
                                string="Software PIN" />

                            <field name="connector_test_set_id" string="Test Set ID" />
                        </group>
                    </group>
                    <group string="Rangos de Numeración DIAN">
                        <div class="mb8" colspan="2">
                            <button name="action_GetNumberingRange" string="Consultar Rangos" type="object" class="btn-primary" icon="fa-refresh"/>
                        </div>
                        
                        <field name="connector_numbering_ranges" nolabel="1" readonly="1" colspan="2" placeholder="Presione 'Consultar Rangos' para obtener la información de DIAN"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>