<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_sequence_form_dian_ranges" model="ir.ui.view">
        <field name="name">ir.sequence.form.dian.ranges</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_range_ids']/list/field[@name='date_from']"
                position="before">
                <field name="dian_resolution_number" optional="show" />
                <field name="dian_resolution_date" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='date_range_ids']/list/field[@name='number_next_actual']"
                position="before">
                <field name="dian_number_from" optional="show" />
                <field name="dian_number_to" optional="show" />
            </xpath>
            <xpath expr="//field[@name='date_range_ids']/list/field[@name='number_next_actual']"
                position="after">
                <field name="dian_technical_key" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo> 