<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_move_form_facturapi" model="ir.ui.view">
      <field name="name">account.move.form.facturapi</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//group[@name='misc_group']" position="inside">
          <field name="invoice_time" string="Issue Time"/>
          <field name="l10n_co_resolution_number" string="Resolution Number"/>
          <field name="l10n_co_resolution_date" string="Resolution Date"/>
          <field name="l10n_co_resolution_date_from" string="Valid From"/>
          <field name="l10n_co_resolution_date_to" string="Valid To"/>
          <field name="l10n_co_resolution_number_from" string="Number From"/>
          <field name="l10n_co_resolution_number_to" string="Number To"/>
          <field name="l10n_co_authorization_prefix" string="Authorization"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
