<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_facturapi_import_cufe" model="ir.ui.view">
        <field name="name">account.move.form.facturapi.import.cufe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <widget name="web_ribbon" title="Importada DIAN" bg_color="text-bg-success"
                    invisible="not connector_import_cufe"/>
                <div class="alert alert-info" role="alert"
                    invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold">Factura Electrónica DIAN:</span>
                        <field name="connector_import_cufe" nolabel="1"
                            placeholder="Pegue aquí el CUFE del documento del proveedor..."/>
                        <button name="action_connector_import_by_cufe" type="object"
                            string="Importar por CUFE" class="btn-primary"
                            icon="fa-download"
                            help="Consulta el XML firmado en la DIAN con el CUFE y llena automáticamente la factura."/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
