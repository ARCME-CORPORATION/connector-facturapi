<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_dian_payment_method" model="ir.ui.view">
        <field name="name">account.journal.form.dian.payment.method</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="inside">
                <group name="dian_payment_method" string="Facturación Electrónica DIAN" invisible="type not in ['bank', 'cash', 'credit']">
                    <field name="connector_dian_payment_method_code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
