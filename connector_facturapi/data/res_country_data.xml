<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Force Colombia to require a city on every address (DANE city codes are mandatory for DIAN).
             Uses the same external ID as the base module to update the existing country record. -->
        <record id="base.co" model="res.country">
            <field name="enforce_cities" eval="True"/>
        </record>
    </data>
</odoo>
